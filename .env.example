# Template. Copy to .env.local and fill in. Safe to commit — no secrets here.
# See .env.local for what each value does.

# --- Perfect Corp ------------------------------------------------------------
PERFECTCORP_API_KEY=
PERFECTCORP_SECRET_KEY=
PERFECTCORP_API_BASE=https://yce-api-01.makeupar.com
# PERFECTCORP_LIVE=1    forces a live call past the cache
# PERFECTCORP_OFFLINE=1 forbids live calls entirely. Zero units, guaranteed.
PERFECTCORP_LIVE=
PERFECTCORP_OFFLINE=

# --- Supabase: the shared fixture cache --------------------------------------
#
# Optional. Without these the app behaves exactly as it does today — local
# fixtures replay, live calls work, nothing throws.
#
# But set them in PRODUCTION. Vercel's runtime filesystem is read-only, so a
# deployment can read the fixtures committed to git and can never write a new
# one. Without a shared cache, every look a real user builds is billed again,
# in full, every time anyone builds it.
#
# Both values are in the Supabase dashboard under Project Settings > API:
#   SUPABASE_URL               "Project URL", e.g. https://abcdefgh.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY  the `service_role` key, NOT `anon`
#
# The service role key bypasses row-level security. It is read only inside
# Next.js route handlers and must never reach the browser — same rule as
# PERFECTCORP_API_KEY. Never prefix it with NEXT_PUBLIC_.
#
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Setup only. `npm run setup:supabase` uses this to apply supabase/schema.sql
# and create the storage bucket, so neither has to be done by hand.
#
# Get one at https://supabase.com/dashboard/account/tokens
#
# This is an ACCOUNT-level admin credential, and the running app never reads it.
# Keep it in .env.local and do NOT add it to Vercel — a deployment holding it
# would carry admin rights it has no use for.
SUPABASE_ACCESS_TOKEN=

# Ceiling on units one session may spend. Defaults to 120 when unset.
SESSION_UNIT_CAP=
